# Production Environment Variables
# Copy this file to .env.prod and fill in your actual production values

# Database Configuration (use managed database service)
DATABASE_URL=postgresql://user:password@your-db-host:5432/minerva_prod
POSTGRES_DB=minerva_prod
POSTGRES_USER=minerva_user
POSTGRES_PASSWORD=your-secure-password

# Redis Configuration (use managed redis service)
REDIS_URL=redis://your-redis-host:6379/0

# Django Configuration
SECRET_KEY=your-super-secret-production-key-here
DEBUG=False
ALLOWED_HOSTS=your-domain.com,www.your-domain.com
CORS_ALLOWED_ORIGINS=https://your-domain.com,https://www.your-domain.com
DJANGO_SETTINGS_MODULE=minervahome.settings_prod

# Frontend Configuration
NEXT_PUBLIC_API_URL=https://your-domain.com/api
NODE_ENV=production

# SSL Configuration
SSL_CERT_PATH=/etc/nginx/ssl/cert.pem
SSL_KEY_PATH=/etc/nginx/ssl/private.key

# Email Configuration (for production notifications)
EMAIL_HOST=smtp.your-provider.com
EMAIL_PORT=587
EMAIL_HOST_USER=your-email@your-domain.com
EMAIL_HOST_PASSWORD=your-email-password
EMAIL_USE_TLS=True

# Monitoring & Analytics
SENTRY_DSN=your-sentry-dsn-here
GOOGLE_ANALYTICS_ID=your-ga-id-here

# Docker Registry (if using private registry)
DOCKER_REGISTRY=registry.digitalocean.com/your-username/minerva-registry