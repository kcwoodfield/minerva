# Example environment variables for deployment
# Copy to .env (local) or your host's secret store (production).
# Do not commit files containing real credentials.

# PostgreSQL
POSTGRES_DB=minerva
POSTGRES_USER=minerva_user
POSTGRES_PASSWORD=change-me
DATABASE_URL=postgresql://minerva_user:change-me@localhost:5432/minerva

# ASP.NET Core
ConnectionStrings__DefaultConnection=Host=localhost;Port=5434;Database=minerva;Username=postgres;Password=change-me
GoogleBooks__ApiKey=

# React client (build-time)
VITE_API_URL=http://localhost:5000

# CORS (comma-separated origins for the API)
Cors__Origins=http://localhost:5174
