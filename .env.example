# Example environment variables for deployment
# Copy to .env (local) or your host's secret store (production).
# Do not commit files containing real credentials.

# PostgreSQL
POSTGRES_DB=minerva
POSTGRES_USER=minerva_user
POSTGRES_PASSWORD=change-me
DATABASE_URL=postgresql://minerva_user:change-me@localhost:5432/minerva

# ASP.NET Core
ConnectionStrings__DefaultConnection=Host=localhost;Port=5434;Database=minerva;Username=postgres;Password=change-me
GoogleBooks__ApiKey=
# ISBN lookup HTTP timeouts (seconds)
BookLookup__RequestTimeoutSeconds=8
BookLookup__OverallTimeoutSeconds=25

# Haiku generation: Ollama (local) or Anthropic (Claude)
HaikuGeneration__Provider=Ollama
HaikuGeneration__Ollama__BaseUrl=http://localhost:11434
HaikuGeneration__Ollama__Model=llama3.2
# HaikuGeneration__Provider=Anthropic
# HaikuGeneration__Anthropic__ApiKey=

# React client (build-time)
VITE_API_URL=http://localhost:5000

# CORS (comma-separated origins for the API)
Cors__Origins=http://localhost:5174
